{
  "manifest_version": 3,
  "name": "Extension Template",
  "description": "可复用的 Chrome 扩展权限与配置模板",
  "version": "1.0.0",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "https://target-domain.com/*",
    "https://www.target-domain.com/*",
    "https://*.target-domain.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.target-domain.com https://*.target-domain.com"
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.target-domain.com/*",
        "https://www.target-domain.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content-scripts/content.js"]
    }
  ]
}
